DATABASE_URL=postgresql://sps_user:REPLACE_ME@localhost:5432/sps_dev
REDIS_URL=redis://localhost:6379
PORT=3001

# CP004: secret must be >=32 chars, provision via secret manager; do not commit values
SPS_INTERNAL_API_URL=http://localhost:3001
# Opaque sessions are stored as SHA-256 hashes in PostgreSQL; no client-provided role or person ID.

# Hostinger Node runtime uses platform assigned PORT; do not hardcode this in source.
NODE_ENV=production
# NEXT_PUBLIC_* variables must never contain credentials.
# DATABASE_URL must point to an actual reachable PostgreSQL 16 service.
